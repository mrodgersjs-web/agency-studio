{
  "schema": "rig.repo-adapters.v1",
  "repo": "mrodgersjs-web/agency-studio",
  "tier": "B_PRODUCT_APP",
  "supabase": {
    "schema": "rig_shared",
    "role": "agency-studio-agent"
  },
  "loops": {
    "default": "iqrsqpi-v20",
    "always_on": [
      "gate-d-loop",
      "proof-loop"
    ]
  },
  "results_mcp": {
    "entry": "mcp/server.py",
    "transport": "stdio",
    "name": "rig-results",
    "protocol_version": "2026-07-28",
    "strict_mcp2": true
  }
}
